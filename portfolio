<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  --bg:#080b11; --panel:#111720; --line:#303c49;
  --cyan:#9bf2ff; --pink:#f5b4e5; --lime:#d7ff9b;
  --text:#e5eaf0; --muted:#83909f;
  --chrome:linear-gradient(135deg,#fff 0%,#7d8a9b 13%,#f4f7ff 25%,#788696 40%,#fff 52%,#a3b2c1 64%,#f6eaff 78%,#758395 100%);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
 margin:0;background:var(--bg);color:var(--text);
 font-family:'Space Grotesk',sans-serif;overflow-x:hidden;
 background-image:radial-gradient(ellipse at 12% 12%,#13283a 0,transparent 35%),
 radial-gradient(ellipse at 90% 80%,#241329 0,transparent 32%);
}
button,input{font:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
::selection{background:var(--cyan);color:#080b11}
.mono{font-family:'DM Mono',monospace}
.noise{position:fixed;inset:0;pointer-events:none;z-index:99;opacity:.055;
 background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E")}
.topbar{height:34px;padding:0 18px;display:flex;align-items:center;justify-content:space-between;
 border-bottom:1px solid var(--line);background:#080b11e8;font-size:10px;letter-spacing:1.4px;color:var(--muted)}
.status{color:var(--lime)}.status:before{content:'● ';font-size:9px}
.shell{max-width:1440px;margin:auto;padding:0 22px 100px}
header{display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--line);gap:15px}
.logo{font-size:18px;font-weight:700;letter-spacing:-1px}
.logo span{color:var(--cyan)}
.nav{display:flex;gap:8px;flex-wrap:wrap}
.nav button,.pill,.window-btn{background:#111720;border:1px solid var(--line);color:var(--text);padding:9px 13px;font:10px 'DM Mono',monospace;letter-spacing:1px;transition:.2s}
.nav button:hover,.pill:hover,.window-btn:hover{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 18px #9bf2ff17}
.hero{min-height:490px;display:grid;grid-template-columns:1.2fr .8fr;gap:30px;align-items:center;padding:55px 0 40px}
.eyebrow{font:10px 'DM Mono',monospace;color:var(--cyan);letter-spacing:3px}
h1{font-size:clamp(64px,11vw,155px);line-height:.77;letter-spacing:-.105em;margin:30px 0 26px;font-weight:600}
h1 .chrome{background:var(--chrome);background-size:200% auto;background-clip:text;-webkit-background-clip:text;color:transparent;animation:shine 8s linear infinite}
@keyframes shine{to{background-position:200% center}}
.hero p{max-width:470px;font-size:15px;line-height:1.9;color:#a5b1c0}
.hero p em{color:var(--pink);font-style:normal}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}
.primary{background:var(--cyan);color:#071017;border:0;padding:13px 17px;font:11px 'DM Mono',monospace;letter-spacing:1px}
.primary:hover{box-shadow:0 0 24px #9bf2ff50;transform:translateY(-2px)}
.deck{border:1px solid #667887;border-radius:5px;background:linear-gradient(140deg,#1a232e,#080b11 60%);
 padding:13px;box-shadow:0 20px 80px #0009, inset 0 0 40px #8edcff08;position:relative}
.deck:before{content:'';position:absolute;inset:4px;border:1px solid #ffffff0a;pointer-events:none}
.deck-top{display:flex;justify-content:space-between;font:9px 'DM Mono',monospace;color:var(--muted);padding:3px 2px 12px}
.orbit{height:270px;position:relative;display:grid;place-items:center;overflow:hidden;
 background:radial-gradient(circle at 50% 50%,#152a37 0,#0a111a 48%,#080b11 75%)}
.orbit:before,.orbit:after{content:'';position:absolute;border:1px solid #9bf2ff3c;border-radius:50%;width:205px;height:205px;animation:rotate 18s linear infinite}
.orbit:after{width:260px;height:115px;transform:rotate(-35deg);border-color:#f5b4e54d;animation:rotate 24s linear infinite reverse}
@keyframes rotate{to{transform:rotate(360deg)}}
.lotus{font-size:112px;z-index:2;filter:drop-shadow(0 0 16px #9bf2ff6a);animation:float 5s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-10px) rotate(4deg)}}
.orbit-label{position:absolute;font:9px 'DM Mono',monospace;color:var(--cyan);z-index:3}
.orbit-label.a{top:16px;left:14px}.orbit-label.b{bottom:15px;right:14px;color:var(--pink)}
.deck-bottom{display:flex;justify-content:space-between;gap:10px;padding-top:12px;font:9px 'DM Mono',monospace;color:var(--muted)}
.marquee{overflow:hidden;border-block:1px solid var(--line);padding:13px 0;color:var(--cyan);font:10px 'DM Mono',monospace;letter-spacing:3px;white-space:nowrap}
.marquee span{display:inline-block;animation:scroll 28s linear infinite}
@keyframes scroll{to{transform:translateX(-50%)}}
.section{padding:60px 0 10px;scroll-margin-top:30px}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:22px}
.section-head h2{font-size:clamp(28px,5vw,47px);letter-spacing:-2px;margin:8px 0 0}
.section-head p{font:10px 'DM Mono',monospace;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.card{background:linear-gradient(145deg,#141c26,#0c1017);border:1px solid var(--line);padding:20px;min-height:190px;position:relative;overflow:hidden;transition:transform .25s,border-color .25s}
.card:hover{transform:translateY(-5px);border-color:#8dd8e6}
.card .num{font:10px 'DM Mono',monospace;color:var(--cyan)}
.card .symbol{font-size:32px;margin:23px 0 17px;filter:drop-shadow(0 0 10px #9bf2ff35)}
.card h3{font-size:19px;margin:0 0 8px;letter-spacing:-.6px}
.card p{font-size:12px;line-height:1.8;color:var(--muted);margin:0 0 18px}
.tags{display:flex;flex-wrap:wrap;gap:5px}
.tags span{border:1px solid #34404c;padding:5px 7px;color:#b8c4d1;font:9px 'DM Mono',monospace}
.card .open{position:absolute;right:16px;top:15px;border:0;background:none;color:var(--cyan);font-size:16px}
.window{border:1px solid #465564;background:#0c1119;box-shadow:0 15px 50px #0007;min-width:0}
.winbar{height:36px;background:linear-gradient(90deg,#dfe7ee,#778a9d 25%,#d5dbe3 52%,#728196 75%,#f0f3f7);color:#0b1118;display:flex;align-items:center;justify-content:space-between;padding:0 10px;font:10px 'DM Mono',monospace;letter-spacing:.5px}
.winbar button{background:#101820;color:#d8e8f1;border:0;width:23px;height:22px;margin-left:4px}
.winbody{padding:18px}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.manifesto{font-size:clamp(24px,4vw,43px);line-height:1.15;letter-spacing:-1.6px;margin:4px 0 22px}
.manifesto i{color:var(--pink);font-style:normal}
.smallcopy{font-size:12px;line-height:1.9;color:var(--muted)}
.flowerbox{min-height:220px;display:grid;place-items:center;text-align:center;
 background:radial-gradient(ellipse,#23313e,#0a0e15 72%);position:relative;overflow:hidden}
.flowerbox .bigflower{font-size:85px;filter:drop-shadow(0 0 16px #eab8ef44);animation:float 6s ease-in-out infinite}
.flowerbox:after{content:'GROW THROUGH THE STATIC';position:absolute;bottom:15px;font:9px 'DM Mono',monospace;letter-spacing:2px;color:var(--pink)}
.skills{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}
.skills span{font-size:11px;border:1px solid #394754;background:#121a23;padding:9px 11px}
.timeline{display:grid;grid-template-columns:100px 1fr;gap:15px;padding:17px 0;border-bottom:1px solid var(--line)}
.timeline .date{font:10px 'DM Mono',monospace;color:var(--cyan);padding-top:4px}
.timeline h3{font-size:15px;margin:0 0 6px}
.timeline p{font-size:12px;color:var(--muted);line-height:1.8;margin:0}
.terminal{font:12px 'DM Mono',monospace;line-height:1.9;color:#c7d4df;min-height:185px}
.terminal .out{color:var(--lime);white-space:pre-wrap;overflow-wrap:anywhere}
.terminal .hint{color:var(--muted)}
.termline{display:flex;gap:8px;margin-top:8px}
.termline label{color:var(--cyan)}
.termline input{background:transparent;border:0;border-bottom:1px solid #34434f;color:white;outline:none;flex:1;min-width:0;font:12px 'DM Mono',monospace}
