  border: 1px solid rgba(165,238,255,.16);
  padding: 13px;
  font: 11px/1.8 var(--mono);
  color: rgba(191,200,210,.8);
  min-height: 240px;
  max-height: 300px;
  overflow: auto;
  overflow-wrap: anywhere;
}

.terminal-output {
  white-space: pre-wrap;
  margin: 0 0 9px;
}

.terminal-output .good {
  color: var(--acid);
}

.terminal-output .purple {
