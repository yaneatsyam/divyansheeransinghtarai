footer{margin-top:70px;border-top:1px solid var(--line);padding:20px 0;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;font:9px 'DM Mono',monospace;color:var(--muted)}
.taskbar{position:fixed;z-index:50;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:6px;align-items:center;
 padding:7px;background:#111720df;backdrop-filter:blur(18px);border:1px solid #71818f;border-radius:4px;box-shadow:0 10px 45px #000a;max-width:calc(100% - 20px)}
.taskbar button{background:#1b2631;border:1px solid #344653;color:#dce6ed;padding:10px 12px;font:10px 'DM Mono',monospace;white-space:nowrap}
.taskbar button:hover{color:var(--cyan);border-color:var(--cyan)}
.taskbar .start{background:var(--chrome);color:#091018;font-weight:bold}
#toast{position:fixed;right:18px;bottom:85px;z-index:80;background:#111b24;border:1px solid var(--cyan);padding:14px 18px;font:11px 'DM Mono',monospace;display:none;max-width:300px}
.cursor-glow{position:fixed;pointer-events:none;width:220px;height:220px;border-radius:50%;background:#8beaff08;transform:translate(-50%,-50%);z-index:0}
.shell, .topbar, .marquee,.taskbar{position:relative;z-index:1}
.taskbar{position:fixed}
@media(min-width:1000px){.hero{min-height:540px}}
@media(max-width:760px){
