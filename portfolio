<script>
const $=s=>document.querySelector(s);
const $$=s=>document.querySelectorAll(s);
const started=Date.now();

function clock(){
 const d=new Date();
 $('#clock').textContent=d.toLocaleTimeString('en-GB',{hour12:false});
 const t=Math.floor((Date.now()-started)/1000);
 $('#uptime').textContent='UPTIME '+String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0');
}
clock();setInterval(clock,1000);
$('#year').textContent=new Date().getFullYear();

function toast(msg){
 const el=$('#toast');el.textContent=msg;el.style.display='block';
 clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.style.display='none',2600);
}
$$('[data-go]').forEach(b=>b.addEventListener('click',()=>{
 const target=document.getElementById(b.dataset.go);
 if(target)target.scrollIntoView({behavior:'smooth',block:'start'});
}));
$('#random').addEventListener('click',()=>{
 const sections=['work','about','log','terminal','contact'];
 const target=sections[Math.floor(Math.random()*sections.length)];
 document.getElementById(target).scrollIntoView({behavior:'smooth'});
