}

.terminal-input-row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.terminal-prompt {
  color: var(--acid);
}

.terminal-input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
  font: inherit;
