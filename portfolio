<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090b10">

<title>YAN.EXE — afterlife operating system</title>

<meta name="description"
content="A living archive of art, writing, graphic design, websites, and everything that refuses to stay still.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&family=Caveat:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* =========================================================
   YAN.EXE — AFTERLIFE OPERATING SYSTEM
   One-file cyberdeck portfolio
   ========================================================= */

:root {
  --void: #090b10;
  --chrome: #bfc8d2;
  --cyan: #a5eeff;
  --lilac: #c6a6ff;
  --pea: #f2b7d0;
  --acid: #c9f28d;
  --red: #ff526c;
  --green: #7bd6ae;

  --glass: rgba(13, 18, 27, .79);
  --border: rgba(191, 200, 210, .25);

  --mono: "DM Mono", monospace;
  --sans: "Space Grotesk", sans-serif;
  --hand: "Caveat", cursive;

  --mx: 0px;
  --my: 0px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--void);
}

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--void);
  color: var(--chrome);
  font-family: var(--sans);
  cursor: crosshair;
  -webkit-tap-highlight-color: transparent;
}

button,
input {
  font: inherit;
}

button {
  color: inherit;
}

button:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 4px;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: var(--cyan);
  text-decoration: none;
}

button {
  cursor: pointer;
}

/* BACKGROUND FILM */

.scene {
  position: fixed;
  inset: -5%;
  z-index: -5;
  pointer-events: none;
  background:
    radial-gradient(
      ellipse at calc(52% + var(--mx))
      calc(38% + var(--my)),
      rgba(30, 79, 117, .28),
      transparent 42%
    ),
    radial-gradient(
      ellipse at 15% 85%,
      rgba(0, 91, 75, .23),
      transparent 38%
    ),
    radial-gradient(
      ellipse at 85% 24%,
      rgba(99, 44, 85, .19),
      transparent 38%
    ),
    linear-gradient(
      125deg,
      #090b10 5%,
      #111b2b 42%,
      #0b201e 73%,
      #090b10 100%
    );

  transform: scale(1.04);
  transition: filter 1.5s, background-color 1s;
  animation: filmDrift 24s ease-in-out infinite alternate;
}

.scene::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .55;
  background:
    linear-gradient(
      90deg,
      transparent 0 8%,
      rgba(0, 0, 0, .4) 9% 10%,
      transparent 11% 30%,
      rgba(50, 150, 173, .07) 31% 34%,
      transparent 35% 100%
    ),
    repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 6px,
      rgba(0, 0, 0, .08) 7px,
      transparent 8px
    );
  mix-blend-mode: screen;
}

.scene::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.3),
      transparent 20%,
      transparent 70%,
      rgba(0,0,0,.65)
    );
}

@keyframes filmDrift {
  0% {
    transform: scale(1.04) translate(-.5%, 0);
    filter: hue-rotate(0deg);
  }
  100% {
    transform: scale(1.08) translate(.5%, -.5%);
    filter: hue-rotate(13deg);
  }
}

/* GRAIN */

.grain {
  position: fixed;
  inset: -50%;
  z-index: 1000;
  width: 200%;
  height: 200%;
  pointer-events: none;
  opacity: .095;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E");
  animation: grainMove .22s steps(2) infinite;
}

@keyframes grainMove {
  0% { transform: translate(0,0); }
  25% { transform: translate(-1%,1%); }
  50% { transform: translate(1%,-1%); }
  75% { transform: translate(-1%,-1%); }
  100% { transform: translate(1%,1%); }
}

.scanlines {
  position: fixed;
  inset: 0;
  z-index: 999;
  pointer-events: none;
  opacity: .14;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0px,
    transparent 3px,
    rgba(0,0,0,.45) 4px
  );
}

body.night .grain {
  opacity: .17;
}

body.night .scene {
  filter: hue-rotate(24deg) saturate(1.5);
}

body.night .scanlines {
  opacity: .23;
}

body.night {
  --glass: rgba(5, 8, 13, .9);
  --border: rgba(197, 166, 255, .28);
}

/* SYSTEM BAR */

.statusbar {
  height: 35px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 0 22px;
  position: relative;
  z-index: 80;
  border-bottom: 1px solid var(--border);
  background: rgba(5, 7, 11, .72);
  backdrop-filter: blur(16px);
  font: 10px var(--mono);
  letter-spacing: .08em;
  text-transform: uppercase;
}

.status-left,
.status-right {
  display: flex;
  align-items: center;
  gap: 13px;
}

.status-logo {
  color: white;
  font-weight: 500;
}

.status-light {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: var(--acid);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--acid);
  animation: pulse 1.8s infinite;
}

@keyframes pulse {
  50% { opacity: .35; }
}

/* HERO */

.hero {
  min-height: calc(100svh - 100px);
  min-height: max(640px, calc(100svh - 100px));
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 45px 18px 100px;
  isolation: isolate;
}

.hero-kicker {
  font: 10px var(--mono);
  letter-spacing: .28em;
  color: var(--cyan);
  text-transform: uppercase;
  margin-bottom: 20px;
  animation: reveal .9s both;
}

.hero-name {
  margin: 0;
  position: relative;
  z-index: 3;
  font-size: clamp(78px, 17.5vw, 225px);
  line-height: .76;
  letter-spacing: -.105em;
  padding-right: .105em;
  font-weight: 700;
  text-align: center;

  background:
    linear-gradient(
      178deg,
      #fff 0%,
      #d6dce3 13%,
      #737e8a 23%,
      #f6f8ff 32%,
      #79828d 43%,
      #fff 51%,
      #707c88 61%,
      #e9f0f5 72%,
      #5c6570 85%,
      #e2e6ea 100%
    );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;

  filter: drop-shadow(0 8px 28px rgba(165,238,255,.09));
  animation: nameArrival 1.4s cubic-bezier(.2,.8,.2,1) both;
}

@keyframes nameArrival {
  0% {
    opacity: 0;
    filter: blur(18px);
    transform: translateY(18px);
  }
  100% {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}

.hero-subtitle {
  margin: 24px 0 0;
  font: 11px var(--mono);
  text-transform: uppercase;
  letter-spacing: .14em;
  text-align: center;
  color: rgba(191,200,210,.7);
  animation: reveal 1.4s .3s both;
}

@keyframes reveal {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.hero-caption {
  margin-top: 9px;
  font: 21px var(--hand);
  color: var(--pea);
  transform: rotate(-3deg);
}

/* FLOWER OVER THE NAME */

.hero-flower {
  position: absolute;
  z-index: 4;
  top: 33%;
  left: 68%;
  width: clamp(90px, 16vw, 195px);
  overflow: visible;
  transform: rotate(17deg);
  pointer-events: none;
  filter: drop-shadow(0 0 8px rgba(242,183,208,.12));
}

.hero-flower path,
.hero-flower ellipse {
  fill: none;
  stroke: var(--pea);
  stroke-width: 2.1;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 500;
  stroke-dashoffset: 500;
  animation: drawFlower 4s 1s ease forwards;
}

.hero-flower .leaf {
  stroke: var(--acid);
}

@keyframes drawFlower {
  to { stroke-dashoffset: 0; }
}

/* FLOATING NOTES */

.scribble {
  position: absolute;
  font: 20px var(--hand);
  z-index: 4;
  pointer-events: none;
}

.note-a {
  left: 8%;
  top: 29%;
  color: var(--lilac);
  transform: rotate(-9deg);
}

.note-b {
  right: 7%;
  bottom: 32%;
  color: var(--pea);
  transform: rotate(7deg);
}

.note-c {
  left: 13%;
  bottom: 24%;
  color: var(--acid);
  transform: rotate(4deg);
}

.crossed {
  text-decoration: line-through;
  opacity: .55;
}

/* LOTUS ORBIT */

.orbit-wrap {
  width: 155px;
  height: 155px;
  position: relative;
  display: grid;
  place-items: center;
  margin-top: 36px;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.orbit {
  position: absolute;
  inset: 8px;
  border: 1px solid rgba(191,200,210,.3);
  border-radius: 50%;
  transform: rotate(-20deg) scaleY(.55);
}

.orbit.two {
  inset: 19px -10px;
  transform: rotate(57deg) scaleY(.7);
  border-color: rgba(165,238,255,.35);
}

.orbit.three {
  inset: -4px 23px;
  transform: rotate(80deg) scaleY(.75);
  border-color: rgba(198,166,255,.25);
}

.orbit-dot {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--cyan);
  top: 7px;
  left: 47%;
  box-shadow: 0 0 12px var(--cyan);
  animation: orbitSpin 8s linear infinite;
}

@keyframes orbitSpin {
  from { transform: rotate(0deg) translateX(66px) rotate(0deg); }
  to { transform: rotate(360deg) translateX(66px) rotate(-360deg); }
}

.lotus {
  width: 62px;
  height: 62px;
  position: relative;
  filter: drop-shadow(0 0 13px rgba(165,238,255,.28));
  animation: lotusFloat 3.8s ease-in-out infinite;
}

@keyframes lotusFloat {
  0%,100% { transform: translateY(0) rotate(-3deg); }
  50% { transform: translateY(-7px) rotate(3deg); }
}

.lotus path {
  fill: rgba(165,238,255,.11);
  stroke: var(--chrome);
  stroke-width: 1.2;
  stroke-linejoin: round;
}

.lotus path:nth-child(2n) {
  stroke: var(--cyan);
}

.lotus-label {
  position: absolute;
  top: 100%;
  margin-top: 11px;
  white-space: nowrap;
  font: 9px var(--mono);
  letter-spacing: .16em;
  color: rgba(191,200,210,.7);
}

/* TERMINAL */

.terminal-teaser {
  position: absolute;
  bottom: 76px;
  left: 50%;
  transform: translateX(-50%);
  width: min(380px, 86vw);
  padding: 13px 16px;
  border: 1px solid rgba(165,238,255,.25);
  background: rgba(5,9,15,.7);
  backdrop-filter: blur(15px);
  box-shadow: 0 10px 60px rgba(0,0,0,.2);
  cursor: pointer;
  transition: border-color .3s, transform .3s;
}

.terminal-teaser:hover {
  border-color: var(--cyan);
  transform: translateX(-50%) translateY(-3px);
}

.terminal-head {
  font: 9px var(--mono);
  color: var(--cyan);
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  letter-spacing: .1em;
}

.terminal-line {
  font: 11px var(--mono);
  color: rgba(225,237,245,.9);
}

.terminal-line::before {
  content: "> ";
  color: var(--acid);
}

.cursor {
  display: inline-block;
  width: 6px;
  height: 12px;
  vertical-align: -2px;
  background: var(--cyan);
  animation: blink 1s steps(2) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

/* TASKBAR */

.taskbar {
  position: fixed;
  z-index: 150;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  width: max-content;
  max-width: calc(100vw - 24px);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 7px;
  border: 1px solid rgba(191,200,210,.32);
  background: rgba(7,10,16,.82);
  backdrop-filter: blur(22px);
  box-shadow: 0 10px 45px rgba(0,0,0,.4);
}

.task {
  border: 1px solid transparent;
  background: transparent;
  min-width: 52px;
  min-height: 49px;
  padding: 5px 9px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4px;
  transition: .2s;
  font: 8px var(--mono);
  color: rgba(191,200,210,.75);
}

.task:hover,
.task:focus-visible {
  background: rgba(165,238,255,.08);
  border-color: rgba(165,238,255,.25);
  color: white;
  transform: translateY(-4px);
}

.task-icon {
  font-size: 19px;
  line-height: 1;
}

/* UTILITY BUTTONS */

.utility-bar {
  position: fixed;
  z-index: 160;
  top: 47px;
  right: 18px;
  display: flex;
  gap: 7px;
}

.utility {
  background: rgba(7,10,16,.75);
  border: 1px solid var(--border);
  backdrop-filter: blur(12px);
  padding: 8px 10px;
  font: 9px var(--mono);
  letter-spacing: .05em;
  transition: .2s;
}

.utility:hover {
  border-color: var(--cyan);
  color: var(--cyan);
}

/* GARDEN FLOWERS */

.garden-flower {
  position: fixed;
  z-index: 20;
  width: 36px;
  height: 54px;
  border: none;
  background: transparent;
  padding: 0;
  cursor: pointer;
  animation: gardenSway 4s ease-in-out infinite;
  transition: filter .3s, transform .3s;
}

.garden-flower:hover {
  filter: drop-shadow(0 0 9px var(--pea));
  transform: scale(1.2);
}

.garden-flower svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.garden-flower path,
.garden-flower ellipse {
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.garden-flower path {
  stroke: var(--pea);
}

.garden-flower .stem {
  stroke: var(--acid);
}

.garden-flower .leaf {
  stroke: var(--green);
}

.garden-flower:nth-of-type(even) {
  animation-delay: -1.8s;
}

@keyframes gardenSway {
  0%,100% { rotate: -5deg; }
  50% { rotate: 5deg; }
}

.garden-note {
  position: fixed;
  z-index: 190;
  max-width: 210px;
  padding: 10px 12px;
  border: 1px solid rgba(242,183,208,.4);
  background: rgba(9,11,16,.94);
  color: var(--pea);
  font: 16px var(--hand);
  pointer-events: none;
  opacity: 0;
  transform: translateY(5px);
  transition: .2s;
}

.garden-note.visible {
  opacity: 1;
  transform: translateY(0);
}

/* WINDOW SYSTEM */

.desktop {
  position: fixed;
  inset: 0;
  z-index: 100;
  pointer-events: none;
}

.window {
  position: absolute;
  pointer-events: auto;
  width: min(530px, calc(100vw - 30px));
  max-height: min(78vh, 680px);
  overflow: hidden;
  border: 1px solid rgba(191,200,210,.38);
  background: var(--glass);
  backdrop-filter: blur(25px);
  box-shadow:
    0 30px 90px rgba(0,0,0,.48),
    inset 0 1px rgba(255,255,255,.07);
  animation: windowOpen .38s cubic-bezier(.2,.8,.2,1) both;
}

.window.motion {
  animation: windowOpen .38s cubic-bezier(.2,.8,.2,1) both;
}

@keyframes windowOpen {
  0% {
    opacity: 0;
    filter: blur(9px);
    transform: translateY(15px) scale(.97);
  }
  100% {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0) scale(1);
  }
}

.window.minimized {
  display: none;
}

.window.maximized {
  position: fixed !important;
  inset: 48px 12px 82px 12px !important;
  width: auto !important;
  max-height: none;
  height: auto;
}

.window-bar {
  min-height: 37px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
  border-bottom: 1px solid var(--border);
  background: rgba(255,255,255,.025);
  cursor: grab;
  touch-action: none;
  user-select: none;
}

.window-bar:active {
  cursor: grabbing;
}

.window-title {
  font: 9px var(--mono);
  letter-spacing: .08em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}

.window-led {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--acid);
  box-shadow: 0 0 7px var(--acid);
}

.window-actions {
  display: flex;
  gap: 5px;
}

.window-action {
  width: 23px;
  height: 23px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,.035);
  font: 12px var(--mono);
  display: grid;
  place-items: center;
}

.window-action:hover {
  border-color: var(--cyan);
  color: var(--cyan);
}

.window-action.close:hover {
  border-color: var(--red);
  color: var(--red);
}

.window-content {
  padding: 23px;
  max-height: calc(min(78vh, 680px) - 38px);
  overflow-y: auto;
  overscroll-behavior: contain;
}

.window.maximized .window-content {
  max-height: calc(100% - 38px);
}

.window-content::-webkit-scrollbar {
  width: 4px;
}

.window-content::-webkit-scrollbar-thumb {
  background: rgba(165,238,255,.4);
}

/* CONTENT STYLING */

.eyebrow {
  font: 9px var(--mono);
  color: var(--cyan);
  letter-spacing: .2em;
  text-transform: uppercase;
}

.content-title {
  margin: 13px 0;
  font-size: clamp(29px, 5vw, 42px);
  line-height: .98;
  letter-spacing: -.06em;
  color: white;
  font-weight: 600;
}

.content-title .accent {
  color: var(--lilac);
}

.body-copy {
  font-size: 13px;
  line-height: 1.9;
  color: rgba(218,226,235,.8);
}

.handwriting {
  font: 25px var(--hand);
  line-height: 1.2;
  color: var(--pea);
  transform: rotate(-2deg);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin: 18px 0;
}

.tag {
  padding: 6px 8px;
  border: 1px solid var(--border);
  font: 9px var(--mono);
  color: var(--cyan);
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 12px;
  margin-top: 20px;
}

.project-card {
  position: relative;
  min-height: 150px;
  padding: 15px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 20px;
  background:
    radial-gradient(ellipse at 80% 20%, rgba(165,238,255,.1), transparent 60%),
    rgba(255,255,255,.025);
  border: 1px solid rgba(191,200,210,.25);
  transition: .25s;
}

.project-card::after {
  content: "✳";
  position: absolute;
  right: -9px;
  top: -16px;
  font: 36px var(--hand);
  color: var(--pea);
  transform: rotate(15deg);
}

.project-card:hover {
  border-color: var(--cyan);
  transform: translateY(-3px);
}

.project-number {
  font: 9px var(--mono);
  color: var(--acid);
}

.project-name {
  font-size: 20px;
  line-height: 1.1;
  letter-spacing: -.04em;
  color: white;
}

.project-description {
  font: 10px/1.7 var(--mono);
  color: rgba(191,200,210,.7);
}

.project-link {
  font: 9px var(--mono);
  margin-top: 9px;
  display: inline-block;
}

.poem {
  padding: 20px 0;
  border-bottom: 1px solid var(--border);
}

.poem:last-child {
  border-bottom: none;
}

.poem-title {
  color: white;
  font-size: 20px;
  margin-bottom: 8px;
}

.poem-text {
  font: 21px/1.5 var(--hand);
  color: rgba(242,183,208,.92);
  white-space: pre-line;
}

.archive-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--border);
  padding: 14px 0;
  font-size: 12px;
}

.archive-row:last-child {
  border-bottom: 0;
}

.archive-year {
  color: var(--acid);
  font: 9px var(--mono);
}

.contact-link {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
  font: 11px var(--mono);
}

.contact-link:hover {
  color: var(--pea);
}

.contact-link:last-child {
  border-bottom: 0;
}

