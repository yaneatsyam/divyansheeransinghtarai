// Ambient oscillator music; starts only after a deliberate click.
let audioCtx=null,oscillators=[],playing=false;
$('#sound').addEventListener('click',async()=>{
 if(playing){
  oscillators.forEach(o=>{try{o.stop()}catch(e){}});
  oscillators=[];playing=false;$('#sound').textContent='♫ SOUND: OFF';toast('AMBIENT AUDIO OFF');return;
 }
 try{
  audioCtx=new (window.AudioContext||window.webkitAudioContext)();
  [110,164.81,220].forEach((freq,i)=>{
   const o=audioCtx.createOscillator(),g=audioCtx.createGain();
   o.type=i===1?'sine':'triangle';o.frequency.value=freq;g.gain.value=.012;
   o.connect(g);g.connect(audioCtx.destination);o.start();oscillators.push(o);
  });
  playing=true;$('#sound').textContent='♫ SOUND: ON';toast('LOW-FREQUENCY DREAM SEQUENCE');
 }catch(e){toast('AUDIO IS NOT AVAILABLE IN THIS BROWSER.')}
});

// Switch between default night mode and an alternate high-contrast mode.
let alt=false;
$('#theme').addEventListener('click',()=>{
 alt=!alt;
 document.documentElement.style.setProperty('--cyan',alt?'#e7ff9b':'#9bf2ff');
 document.documentElement.style.setProperty('--pink',alt?'#ffbf91':'#f5b4e5');
 document.documentElement.style.setProperty('--bg',alt?'#11100b':'#080b11');
 toast(alt?'ALTERNATE FREQUENCY ENABLED':'ORIGINAL FREQUENCY RESTORED');
});

// Subtle pointer glow on devices with a fine pointer.
if(matchMedia('(pointer:fine)').matches){
 document.addEventListener('pointermove',e=>{
  const g=$('#glow');g.style.left=e.clientX+'px';g.style.top=e.clientY+'px';
 });
}
