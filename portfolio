function openWindow(title,content){
 const w=document.createElement('div');
 w.className='window';
 w.style.cssText='position:fixed;z-index:70;width:min(500px,calc(100% - 24px));left:50%;top:50%;transform:translate(-50%,-50%);box-shadow:0 30px 120px #000d';
 w.innerHTML=`<div class="winbar"><span>${title}</span><button class="close" aria-label="Close window">✕</button></div><div class="winbody smallcopy">${content}</div>`;
 document.body.appendChild(w);
 w.querySelector('.close').onclick=()=>w.remove();
 // Drag window by its title bar on desktop and touch devices.
 const bar=w.querySelector('.winbar');
 let drag=null;
 bar.style.cursor='move';
 bar.addEventListener('pointerdown',e=>{
  if(e.target.closest('button'))return;
  const r=w.getBoundingClientRect();
  drag={x:e.clientX-r.left,y:e.clientY-r.top};
  bar.setPointerCapture(e.pointerId);
 });
 bar.addEventListener('pointermove',e=>{
  if(!drag)return;
  w.style.left=(e.clientX-drag.x+w.offsetWidth/2)+'px';
  w.style.top=(e.clientY-drag.y+w.offsetHeight/2)+'px';
  w.style.transform='translate(-50%,-50%)';
 });
 bar.addEventListener('pointerup',()=>drag=null);
}
const terminalCommands={
 help:'COMMANDS: help, about, work, socials, flower, date, clear, contact, sudo',
 about:'YAN.EXE // multidisciplinary creative. designer, writer, web builder. currently growing through the static.',
 work:'FILES AVAILABLE: design / web / writing / editorial / food / misc. Click a card in THE FILES section.',
 socials:'INSTAGRAM: @yanrata_ | SUBSTACK: @yanrata | add your other verified links in index.html.',
 flower:'LOTUS_PROTOCOL: remain soft without surrendering. grow through the concrete. 🌸',
 date:()=>new Date().toString(),
 contact:'CONTACT ROUTE OPEN. Scroll to MAKE CONTACT or configure your email link in index.html.',
 sudo:'permission denied: the flowers are in charge here.'
};
const out=$('#terminalOutput'),input=$('#command');
function runCommand(raw){
 const cmd=raw.trim().toLowerCase();
 if(!cmd)return;
 const line=document.createElement('div');
 line.textContent='yan@deck:~$ '+raw;out.insertBefore(line,out.querySelector('.termline'));
 const result=document.createElement('div');result.className='out';
 if(cmd==='clear'){out.querySelectorAll(':scope > div:not(.termline)').forEach(x=>x.remove());return}
 result.textContent=Object.prototype.hasOwnProperty.call(terminalCommands,cmd)?
 (typeof terminalCommands[cmd]==='function'?terminalCommands[cmd]():terminalCommands[cmd]):
 'command not found: '+cmd+' — type help for available commands.';
 out.insertBefore(result,out.querySelector('.termline'));
 out.scrollTop=out.scrollHeight;
}
input.addEventListener('keydown',e=>{
 if(e.key==='Enter'){runCommand(input.value);input.value=''}
});
$('#clearTerm').addEventListener('click',()=>{
 out.querySelectorAll(':scope > div:not(.termline)').forEach(x=>x.remove());
});
